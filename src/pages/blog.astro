---
import Base from "../layouts/Base.astro";
import { site } from "../content/site";
import HeaderAndLink from "../components/mise-en-page/HeaderAndLink.astro";
const title = "Blog";
const posts = Object.values(
  import.meta.glob("../blogposts/*.md", { eager: true }),
);

const blogs = posts
  .map((post: any) => ({
    titre: post.frontmatter.titre,
    author: post.frontmatter.author,
    date: post.frontmatter.date,
    url: post.url,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Base title={title} description={`Blog — ${site.name}`} canonicalPath="/blog">
  <article class="prose">
    <h1>Blog</h1>
      {
        blogs.map((blog) => (
            <HeaderAndLink href={blog.url}>{blog.titre}</HeaderAndLink>
            <p class="lead">
              Par {blog.author} —{" "}
              {new Date(blog.date).toLocaleDateString("fr-CA")}
            </p>
        ))
      }
  </article>
</Base>
