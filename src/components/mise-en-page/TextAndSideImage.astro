---
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<div class="image-text">
  <div class="image-text__text">
    <slot />
  </div>

  <div class="image-text__image">
    <img src={src} alt={alt} />
  </div>
</div>

<style>
  .image-text {
    display: grid;
    grid-template-columns: 3fr 1fr;
    gap: 1rem;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .image-text__text {
    flex: 0 0 calc(75% - 0.5rem);
  }

  .image-text__image {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 220px;
  }

  .image-text__image img {
    width: 80%; /* Was effectively 100% */
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .image-text {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .image-text__image {
      height: auto;
    }

    .image-text__image img {
      width: 100%;
      max-width: 300px; /* optional */
      height: auto;
    }
  }
</style>
