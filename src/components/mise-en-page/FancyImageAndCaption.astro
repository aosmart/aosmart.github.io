---
interface Props {
  description: string;
}

const { description } = Astro.props;
---

<div class="expandable-image">
  <button
    class="expandable-image__content"
    type="button"
    aria-label="Agrandir l’image"
  >
    <slot />
  </button>

  <div class="expandable-image__overlay" aria-hidden="true">
    <div class="expandable-image__viewer">
      <button class="expandable-image__close" type="button" aria-label="Fermer">
        ×
      </button>

      <div class="expandable-image__viewer-content"></div>

      <p class="expandable-image__caption">
        <Fragment set:html={description} />
      </p>
    </div>
  </div>
</div>

<script>
  function initializeExpandableImages() {
    document.querySelectorAll(".expandable-image").forEach((root) => {
      if (root.hasAttribute("data-initialized")) return;

      root.setAttribute("data-initialized", "");

      const trigger = root.querySelector(".expandable-image__content");
      const overlay = root.querySelector(".expandable-image__overlay");
      const viewerContent = root.querySelector(
        ".expandable-image__viewer-content",
      );
      const closeButton = root.querySelector(".expandable-image__close");
      const image = trigger?.querySelector("img");

      if (
        !(trigger instanceof HTMLButtonElement) ||
        !(overlay instanceof HTMLElement) ||
        !(viewerContent instanceof HTMLElement) ||
        !(closeButton instanceof HTMLButtonElement) ||
        !(image instanceof HTMLImageElement)
      ) {
        return;
      }

      function open() {
        viewerContent.replaceChildren(image.cloneNode(true));
        overlay.classList.add("open");
        overlay.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function close() {
        overlay.classList.remove("open");
        overlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }

      trigger.addEventListener("click", open);
      closeButton.addEventListener("click", close);

      overlay.addEventListener("click", (event) => {
        if (event.target === overlay) {
          close();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && overlay.classList.contains("open")) {
          close();
        }
      });
    });
  }

  initializeExpandableImages();
  document.addEventListener("astro:page-load", initializeExpandableImages);
</script>

<style>
  .expandable-image {
    width: 100%;
  }

  .expandable-image__content {
    width: 100%;
    height: 320px;
    padding: 2px;
    margin-top: 0.5rem;
    border: 0;
    background: transparent;
    cursor: pointer;

    display: flex;
    justify-content: center;
    align-items: center;

    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }

  .expandable-image__content :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .expandable-image__content:hover {
    transform: scale(1.03);
    filter: brightness(1.12);
  }

  .expandable-image__overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;

    display: flex;
    justify-content: center;
    align-items: center;

    padding: 1rem;
    background: rgba(0, 0, 0, 0.8);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }

  .expandable-image__overlay.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .expandable-image__viewer {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;

    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .expandable-image__viewer-content {
    display: flex;
    justify-content: center;
  }

  .expandable-image__viewer-content :global(img) {
    display: block;
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
  }

  .expandable-image__caption {
    margin: 0;
    color: white;
    text-align: center;
  }

  .expandable-image__close {
    position: absolute;
    top: -3rem; /* was -2rem */
    right: 0;

    border: 0;
    background: transparent;
    color: white;

    font-size: 3rem; /* was 2rem */
    line-height: 1;

    cursor: pointer;
    padding: 0;
  }
</style>
