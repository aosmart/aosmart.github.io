---
interface Props {
  description: string;
}

const { description } = Astro.props;
import { marked } from "marked";
---

<div class="image-card">
  <div class="image-card__content">
    <slot />
  </div>

  <div class="image-card__caption lead" set:html={marked.parse(description)} />
</div>

<style>
  .image-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .image-card__content {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .image-card__content :global(img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .image-card__caption {
    color: var(--muted);
  }
  .image-card__caption :global(p) {
    margin: 1;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    color: inherit;
  }
</style>
