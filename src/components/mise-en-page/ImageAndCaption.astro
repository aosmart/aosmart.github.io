---
interface Props {
  description: string;
}

const { description } = Astro.props;
---

<div class="image-card">
  <div class="image-card__content">
    <slot />
  </div>

  <p class="image-card__caption"><Fragment set:html={description} /></p>
</div>

<style>
  .image-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .image-card__content {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .image-card__content :global(img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .image-card__caption {
    color: var(--muted);
  }
</style>
