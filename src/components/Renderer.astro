---
// src/components/Renderer.astro
import { marked } from "marked";
import HeaderAndLink from "../components/mise-en-page/HeaderAndLink.astro";
import ImageAndCaption from "../components/mise-en-page/ImageAndCaption.astro";
import FancyImageAndCaption from "./mise-en-page/FancyImageAndCaption.astro";
import Row from "../components/mise-en-page/Row.astro";
import Chart from "../components/graphiques/Chart.astro";
import Tower from "../components/graphiques/Tower.astro";
import TextAndSideImage from "../components/mise-en-page/TextAndSideImage.astro";
const { sections } = Astro.props;
---

{
  sections?.map((section) => {
    switch (section.type) {
      case "titre":
        return (
          <>
            <h1>{section["titre"]}</h1>
            <p class="lead">{section["sous-texte"]}</p>
          </>
        );
      case "sous-titre":
        return <h2>{section["sous-titre"]}</h2>;

      case "sous-titre-avec-lien":
        return (
          <HeaderAndLink href={section["lien"]}>
            {section["sous-titre"]}
          </HeaderAndLink>
        );

      case "paragraphe":
        return <div set:html={marked.parse(section.paragraphe)} />;

      case "imageLegende":
        return (
          <ImageAndCaption description={section["legende"]}>
            <img src={section["image"]} alt={section["alt"]} />
          </ImageAndCaption>
        );
      case "doubleImageLegende":
        return (
          <Row>
            <ImageAndCaption description={section["legende1"]}>
              <img src={section["image1"]} alt={section["alt1"]} />
            </ImageAndCaption>
            <ImageAndCaption description={section["legende2"]}>
              <img src={section["image2"]} alt={section["alt2"]} />
            </ImageAndCaption>
          </Row>
        );
      case "graphiqueTempsReel":
        return (
          <ImageAndCaption description={section["legende"]}>
            {section["fichier"] === "/graphData/ap200.json" ? (
              <Tower dataSrc={section["fichier"]} />
            ) : (
              <Chart datasets={section["fichier"]} />
            )}
          </ImageAndCaption>
        );

      case "doubleGraphiqueTempsReel":
        return (
          <Row>
            <ImageAndCaption description={section["legende1"]}>
              {section["fichier1"] === "/graphData/ap200.json" ? (
                <Tower dataSrc={section["fichier1"]} />
              ) : (
                <Chart datasets={section["fichier1"]} />
              )}
            </ImageAndCaption>

            <ImageAndCaption description={section["legende2"]}>
              {section["fichier2"] === "/graphData/ap200.json" ? (
                <Tower dataSrc={section["fichier2"]} />
              ) : (
                <Chart datasets={section["fichier2"]} />
              )}
            </ImageAndCaption>
          </Row>
        );
      case "membreEquipe":
        return (
          <TextAndSideImage
            src={section["photo"] || "/images/equipe/null.jpeg"}
            alt={section["nom"]}
          >
            <h4>{section["nom"]}</h4>
            <p class="lead">{section["sous-texte"]}</p>
            <div set:html={marked.parse(section["description"])} />
          </TextAndSideImage>
        );
      case "htmlBlock":
        return <div set:html={section["htmlBlock"]} />;

      case "gallerie_imageLegende":
        return (
          <FancyImageAndCaption description={section["legende"]}>
            <img src={section["image"]} alt={section["alt"]} />
          </FancyImageAndCaption>
        );
      case "gallerie_doubleImageLegende":
        return (
          <Row>
            <FancyImageAndCaption description={section["legende1"]}>
              <img src={section["image1"]} alt={section["alt1"]} />
            </FancyImageAndCaption>
            <FancyImageAndCaption description={section["legende2"]}>
              <img src={section["image2"]} alt={section["alt2"]} />
            </FancyImageAndCaption>
          </Row>
        );
      default:
        return <p>{section.type}</p>;
    }
  })
}
