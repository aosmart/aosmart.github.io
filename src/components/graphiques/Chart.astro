---
interface Props {
  datasets: string;
}

const { datasets } = Astro.props;
---

<div class="chart-container">
  <canvas class="time-series-chart" data-chart-src={datasets}></canvas>
</div>

<script>
  import Chart from "chart.js/auto";
  import "chartjs-adapter-date-fns";

  document.querySelectorAll(".time-series-chart").forEach(async (canvas) => {
    const chartSrc = canvas.dataset.chartSrc;

    const response = await fetch(chartSrc);
    const chartData = await response.json();

    const datasets = chartData.datasets.map((dataset) => ({
      ...dataset,
      borderWidth: 1,
      radius: 0,
      data: dataset.data.map((point) => ({
        x: new Date(point.x).getTime(),
        y: point.y,
      })),
    }));

    const maxPoints = Math.max(
      ...datasets.map((dataset) => dataset.data.length),
    );

    const totalDuration = 5000;
    const delayBetweenPoints = totalDuration / maxPoints;

    const previousY = (ctx) =>
      ctx.index === 0
        ? ctx.chart.scales.y.getPixelForValue(ctx.chart.scales.y.min)
        : ctx.chart
            .getDatasetMeta(ctx.datasetIndex)
            .data[ctx.index - 1].getProps(["y"], true).y;

    const animation = {
      x: {
        type: "number",
        easing: "linear",
        duration: delayBetweenPoints,
        from: NaN,
        delay(ctx) {
          if (ctx.type !== "data" || ctx.xStarted) return 0;
          ctx.xStarted = true;
          return ctx.index * delayBetweenPoints;
        },
      },
      y: {
        type: "number",
        easing: "linear",
        duration: delayBetweenPoints,
        from: previousY,
        delay(ctx) {
          if (ctx.type !== "data" || ctx.yStarted) return 0;
          ctx.yStarted = true;
          return ctx.index * delayBetweenPoints;
        },
      },
    };

    if (datasets.length === 1) {
      const color = "#3F51B5";

      datasets[0].borderColor = color;
      datasets[0].backgroundColor = color;
    }

    new Chart(canvas, {
      type: "line",
      data: {
        datasets,
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation,
        interaction: {
          intersect: false,
        },
        plugins: {
          legend: {
            display: true,
            labels: {
              filter: (legendItem) =>
                legendItem.text && legendItem.text.trim() !== "",
            },
          },
        },
        scales: {
          x: {
            type: "time",
            time: {
              unit: "hour",
              displayFormats: {
                hour: "MMM d HH:mm",
              },
            },
            ticks: {
              maxTicksLimit: 8,
            },
          },
          y: chartData.y ?? {},
        },
      },
    });
  });
</script>

<style>
  .chart-container {
    position: relative;
    width: 100%;
    height: 400px;
  }
</style>
