---
interface Props {
  datasets: string;
}

const { datasets } = Astro.props;
---

<div class="chart-container">
  <canvas class="time-series-chart" data-chart-src={datasets}></canvas>
</div>

<script>
  import Chart from "chart.js/auto";
  import "chartjs-adapter-date-fns";

  document.querySelectorAll(".time-series-chart").forEach(async (canvas) => {
    const chartSrc = canvas.dataset.chartSrc;

    const response = await fetch(chartSrc);
    const chartData = await response.json();

    const datasets = chartData.datasets.map((dataset) => ({
      ...dataset,
      borderWidth: 1,
      radius: 0,
      data: dataset.data.map((point) => ({
        x: new Date(point.x).getTime(),
        y: point.y,
      })),
    }));

    const maxPoints = Math.max(
      ...datasets.map((dataset) => dataset.data.length),
    );

    const totalDuration = 5000;
    const delayBetweenPoints = totalDuration / maxPoints;

    const previousY = (ctx) =>
      ctx.index === 0
        ? ctx.chart.scales.y.getPixelForValue(ctx.chart.scales.y.min)
        : ctx.chart
            .getDatasetMeta(ctx.datasetIndex)
            .data[ctx.index - 1].getProps(["y"], true).y;

    const animation = {
      x: {
        type: "number",
        easing: "linear",
        duration: delayBetweenPoints,
        from: NaN,
        delay(ctx) {
          if (ctx.type !== "data" || ctx.xStarted) return 0;
          ctx.xStarted = true;
          return ctx.index * delayBetweenPoints;
        },
      },
      y: {
        type: "number",
        easing: "linear",
        duration: delayBetweenPoints,
        from: previousY,
        delay(ctx) {
          if (ctx.type !== "data" || ctx.yStarted) return 0;
          ctx.yStarted = true;
          return ctx.index * delayBetweenPoints;
        },
      },
    };

    const defaultColors = [
      // Blues (16)
      "#4E79A7",
      "#5B8FF9",
      "#4C78A8",
      "#6B9AC4",
      "#3E7CB1",
      "#5D8AA8",
      "#4F81BD",
      "#6A95C7",
      "#5A9BD5",
      "#3F88C5",
      "#6D9DC5",
      "#729FCF",
      "#4A90A4",
      "#5C93B8",
      "#648DBF",
      "#7BA7D7",

      // Teals / Greens (16)
      "#5F9EA0",
      "#76B7B2",
      "#4FA3A5",
      "#6FA8A8",
      "#5AAE9E",
      "#6BBBAE",
      "#7CBF9E",
      "#70AD8F",
      "#59A14F",
      "#6FAF73",
      "#7FB77E",
      "#88B04B",
      "#7DAF6D",
      "#8DBA74",
      "#6EA36B",
      "#7CB38A",

      // Oranges / Golds (12)
      "#F28E2B",
      "#E89C45",
      "#E6A15C",
      "#D9923B",
      "#D9A441",
      "#C98F3B",
      "#EDC948",
      "#D8B84C",
      "#D4A857",
      "#E0B15A",
      "#CFA34A",
      "#DDAA63",

      // Reds (10)
      "#E15759",
      "#D96C75",
      "#C76D6D",
      "#C65B5B",
      "#B85C5C",
      "#A95A52",
      "#C97C7C",
      "#B96B6B",
      "#D07A72",
      "#BF6666",

      // Purples (6)
      "#B07AA1",
      "#9C7FB8",
      "#8F77B5",
      "#7F6AAD",
      "#8B84C7",
      "#7A8CC2",

      // Neutrals (4)
      "#9C755F",
      "#A67C6B",
      "#8D99AE",
      "#7F8C8D",
    ];

    if (datasets.length === 1) {
      const color =
        defaultColors[Math.floor(Math.random() * defaultColors.length)];

      datasets[0].borderColor = color;
      datasets[0].backgroundColor = color;
    }

    new Chart(canvas, {
      type: "line",
      data: {
        datasets,
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation,
        interaction: {
          intersect: false,
        },
        plugins: {
          legend: {
            display: true,
            labels: {
              filter: (legendItem) =>
                legendItem.text && legendItem.text.trim() !== "",
            },
          },
        },
        scales: {
          x: {
            type: "time",
            time: {
              unit: "hour",
              displayFormats: {
                hour: "MMM d HH:mm",
              },
            },
            ticks: {
              maxTicksLimit: 8,
            },
          },
          y: chartData.y ?? {},
        },
      },
    });
  });
</script>

<style>
  .chart-container {
    position: relative;
    width: 100%;
    height: 400px;
  }
</style>
